# Copy this file to nook.env to fill it in.
#   cp .env.example nook.env
# nook.env is git-ignored and must never be committed.
#
# The file has to exist for the app to build, because pubspec.yaml lists it as
# an asset — that is how flutter_dotenv reads it. An empty nook.env is fine.
#
# ─────────────────────────────────────────────────────────────────────────────
# EVERYTHING IN THIS FILE IS PUBLIC.
#
# Being an asset means being compiled into the build and served to anyone who
# opens the page. So this file holds settings only: which AI service to call,
# which model to ask it for. No key, token or password belongs in here, and
# the app does not read one from here — there is no code path that would.
#
# Credentials are passed to one build command on one machine instead:
#
#   flutter run -d chrome --dart-define=ANTHROPIC_API_KEY=sk-ant-...
#
# See "Configuration" in README.md. The deployed site passes none, which is
# what makes it safe to publish.
# ─────────────────────────────────────────────────────────────────────────────

# --- Where the AI comes from -------------------------------------------------
# Nook's own AI service, which holds the Anthropic key so this app never has
# to. The app sends it the request; it calls the model and sends the answer
# back. This is how a published build reaches the real model.
#
# A public address by necessity — the browser has to know where to knock — so
# it is a setting, not a secret. Leave it blank and Nook falls back to its
# sample extractor and sample planner, and says so on screen.
#
# Deploying the service takes about five minutes and no payment details; the
# steps are in server/README.md. For the deployed site the same address is set
# as a repository variable named NOOK_AI_BACKEND instead of here.
#
#   AI_BACKEND_URL=https://nook-ai.your-subdomain.workers.dev
AI_BACKEND_URL=

# --- Which model to ask for --------------------------------------------------
# Optional. Leave blank and the service picks, which is the point of letting it
# pick: the model can change without rebuilding and republishing the app. Set
# an id here only to pin a specific one, e.g. claude-haiku-4-5-20251001.
CLAUDE_MODEL=
