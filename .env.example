# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# .env is git-ignored and must never be committed.

# --- NEVER ship or deploy ----------------------------------------------------
# Gemini powers Nook's destination and category detection. The key is billable:
# anyone can read a value compiled into a web build and spend your quota, so it
# is deliberately NOT a repository secret and never reaches the deployed site.
#
# Leave this blank and Nook falls back to its sample extractor, which is exactly
# what the published GitHub Pages build does — and it says so on screen.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=
